# OpenAI 兼容接口的 key（必填）
OPENAI_API_KEY=

# Shared by the API and the Compose Nginx upload limit.
UPLOAD_MAX_SIZE_MB=100

# Optional nested overrides; values are parsed using YAML scalar rules.
# APP_CONFIG__CHAT_GPT__BASE_URL=https://api.openai.com/v1
# APP_CONFIG__CHAT_GPT__MODEL=gpt-4.1-mini
# APP_CONFIG__CHAT_GPT__AUTO_FALLBACK=true
# APP_CONFIG__CHAT_GPT__FALLBACK_MODELS=[model-a, model-b]
# APP_CONFIG__DOCUMENTS__CHUNK_SIZE=500
# APP_CONFIG__AGENT__MAX_TASK_LENGTH=2000

# Agent LangGraph checkpoints (defaults to ./agent_checkpoints.db)
# AGENT_CHECKPOINT_DB=./agent_checkpoints.db
